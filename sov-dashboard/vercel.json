{
  "regions": ["sin1"],
  "functions": {
    "src/app/api/brands/analyze/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/warm",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron?job=daily_views",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron?job=weekly_refresh&limit=50",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron?job=sheets_sync",
      "schedule": "0 9 * * *"
    }
  ]
}
