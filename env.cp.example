# ═══════════════════════════════════════════════════════════════════
# Campaign Panel — Environment Variables
# ═══════════════════════════════════════════════════════════════════

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (fresh project, NOT the SOV panel database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret (for campaign panel sessions)
CAMPAIGN_JWT_SECRET=your-minimum-32-character-secret-here

# Resend (transactional email)
RESEND_API_KEY=re_your_key_here

# YouTube Data API (for creator metric fetch — Phase 2)
YOUTUBE_API_KEY=your-youtube-api-key

# Encryption (for API keys at rest)
API_KEY_ENCRYPTION_SECRET=your-32-char-secret
