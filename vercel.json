{
  "functions": {
    "src/app/api/brands/analyze/route.ts": {
      "maxDuration": 120,
      "memory": 2048
    },
    "src/app/api/cron/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/video/[id]/route.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/warm",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron?job=daily_views",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron?job=sheets_sync",
      "schedule": "0 9 * * *"
    }
  ]
}
